# FE3 flash is sixteen physical 32 KiB banks, in BLK1/2/3/5 order.
# boot.asm copies code into Super RAM; the banks below describe runtime IDs.
# RAM123 aliases bank zero's first 8 KiB, so no bank-zero BLK1 storage is used.
SYMBOLS {
 __FE3_BOOT_START__: type=weak, value=$1100;
}
MEMORY {
 ROM0PAD: start=$2000, size=$2000, fill=yes;
 ROM0LO: start=$4000, size=$2000, fill=yes, bank=$a0;
 ROM0TAIL: start=$6000, size=$2000, fill=yes;
 ROM0HI: start=$a000, size=$2000, fill=yes, bank=$a0;
 ROM1LO: start=$2000, size=$5e00, fill=yes, bank=$a1;
 ROM1PAD: start=$7e00, size=$200, fill=yes;
 ROM1HI: start=$a000, size=$2000, fill=yes, bank=$a1;
 ROM2LO: start=$2000, size=$6000, fill=yes, bank=$a2;
 ROM2HI: start=$a000, size=$2000, fill=yes, bank=$a2;
 ROM3PAD: start=$2000, size=$5000, fill=yes;
 ROM3GFX: start=$7000, size=$1000, fill=yes, bank=$a3;
 ROM3HI: start=$a000, size=$2000, fill=yes, bank=$a3;
 ROM4LO: start=$2000, size=$6000, fill=yes, bank=$a4;
 ROM4HI: start=$a000, size=$1800, fill=yes, bank=$a4;
 ROM4TAIL: start=$b800, size=$800, fill=yes;
 ROM5LO: start=$2000, size=$6000, fill=yes, bank=$a5;
 ROM5HI: start=$a000, size=$2000, fill=yes, bank=$a5;
 ROM6LO: start=$2000, size=$6000, fill=yes, bank=$a6;
 ROM6HI: start=$a000, size=$2000, fill=yes, bank=$a6;
 ROM7LO: start=$2000, size=$6000, fill=yes, bank=$a7;
 ROM7HI: start=$a000, size=$2000, fill=yes, bank=$a7;
 ROM8LO: start=$2000, size=$6000, fill=yes, bank=$a8;
 ROM8HI: start=$a000, size=$2000, fill=yes, bank=$a8;
 ROM9LO: start=$2000, size=$6000, fill=yes, bank=$a9;
 ROM9HI: start=$a000, size=$2000, fill=yes, bank=$a9;
 ROM10LO: start=$2000, size=$6000, fill=yes, bank=$aa;
 ROM10HI: start=$a000, size=$2000, fill=yes, bank=$aa;
 ROM11LO: start=$2000, size=$6000, fill=yes, bank=$ab;
 ROM11HI: start=$a000, size=$1800, fill=yes, bank=$a0;
 ROM11TAIL: start=$b800, size=$800, fill=yes;
 ROM12LO: start=$2000, size=$6000, fill=yes, bank=$ac;
 ROM12HI: start=$a000, size=$2000, fill=yes, bank=$ac;
 ROM13LO: start=$2000, size=$6000, fill=yes, bank=$ad;
 ROM13HI: start=$a000, size=$2000, fill=yes, bank=$ad;
 ROM14LO: start=$2000, size=$6000, fill=yes, bank=$ae;
 ROM14HI: start=$a000, size=$2000, fill=yes, bank=$ae;
 ROM15LO: start=$2000, size=$6000, fill=yes, bank=$af;
 ROM15HI: start=$a000, size=$2000, fill=yes, bank=$af;
 LINEPAGE: start=$400, size=$100, bank=$0, file="";
 RAM123: start=$500, size=$b00, bank=$0, file="";
 MAINRAM: start=$7e00, size=$1e0, bank=$a1, file="";
 DIRRAM: start=$6000, size=$400, bank=$a0, file="";
 BOOTRAM: start=__FE3_BOOT_START__, size=$2000-__FE3_BOOT_START__, bank=$0, file="";
 # Native entry/resume in USER, with only the matching continuation in MAIN.
 INTS: start=$7fe0, size=$20, bank=$aa, file="";
 INTS_MAIN: start=$7fe5, size=$1b, bank=$a1, file="";
 RAM2: start=$2000, size=$6000, bank=$a2, file="";
 RAM3: start=$2000, size=$5000, bank=$a3, file="";
 RAM4: start=$2000, size=$6000, bank=$a4, file="";
 RAM4HI: start=$b800, size=$800, bank=$a4, file="";
 RAM5: start=$2000, size=$6000, bank=$a5, file="";
 RAM6: start=$2000, size=$6000, bank=$a6, file="";
 RAM7: start=$2000, size=$6000, bank=$a7, file="";
 RAM8: start=$2000, size=$4000, bank=$a8, file="";
 RAM8COPY: start=$6000, size=$2000, bank=$a8, file="";
 RAM9: start=$2000, size=$6000, bank=$a9, file="";
 RAM0HI: start=$b800, size=$800, bank=$a0, file="";
 SOURCE: start=$2000, size=$6000, bank=$ac, file="";
}
SEGMENTS {
	#-----------------------------------------------------------------------
	# setup (boot block)
	CART:   load=ROM0HI, type=ro, define=yes, optional=yes;

	#-----------------------------------------------------------------------
	# common BSS segments
	SPARE:    load=RAM123,   type=bss;
	LINEBUFF: load=LINEPAGE, type=bss;
	SHAREBSS: load=RAM123,   type=bss;
	SHAREBSS2: load=LINEPAGE, type=bss;

	#-----------------------------------------------------------------------
	# Bank-independent code/data in RAM123; no writable I/O space on FE3.
	SETUP:         load=ROM0HI,             type=ro, define=yes;
	IRQ:           load=ROM0HI, run=RAM123,  type=rw, define=yes;
	BANKCODE:      load=ROM0HI, run=RAM123, type=rw, define=yes;
	BANKCODE2:     load=ROM0HI, run=RAM123, type=rw, define=yes;
	INTS:          load=ROM1LO, run=INTS,   type=rw, define=yes;
	INTS_MAIN:     load=ROM1LO, run=INTS_MAIN, type=rw, define=yes;
	DATA:          load=ROM0HI, run=RAM123,  type=rw, define=yes;

	#-----------------------------------------------------------------------
	# ROM1LO (main code bank)
	DEBUGGER:   load=ROM1LO,   type=rw,  define=yes;
	DBGUI:      load=ROM1LO,   type=ro,  define=yes;
	CODE:       load=ROM1LO,   type=ro,  define=yes;
	RODATA:     load=ROM1HI, type=ro,  define=yes;
	GUICODE:    load=ROM1HI, type=ro,  define=yes;
	ASMBANK:    load=ROM1HI, type=ro,  define=yes;
	EDITCODE:   load=ROM1HI, type=ro,  define=yes;
	BSS:        load=RAM123, type=bss, define=yes, align=2;
	BSS_NOINIT: load=RAM123, type=bss, define=yes;

	#-----------------------------------------------------------------------
	SOURCE:  load=SOURCE, type=bss;

	#-----------------------------------------------------------------------
	# ROM2HI
	DEBUGINFO_CODE: load=ROM2HI, type=ro,  define=yes;
	DEBUGINFO:      load=RAM2, type=bss, define=yes;
	DEBUGINFO_VARS: load=RAM2, type=bss;
	DEBUGINFO_BSS:  load=RAM2, type=bss;

	# Macro/error-log code shares bank 4; its last 2 KiB is private scratch.
	ERRLOG_CODE: load=ROM4HI, type=ro, define=yes;
	ERRLOG_BSS:  load=RAM4HI, type=bss, define=yes;
	FE3MAC_BSS: load=RAM4HI, type=bss;

	#-----------------------------------------------------------------------
	# ROM3HI (shared by UDGEDIT, HELP, MEMCFG, EXPR, and FP)
	# FP is a segment of its own so that the floating point package's size is
	# visible in the map and so it can be relocated by changing this line and
	# FINAL_BANK_FP.  It must stay in the same bank as EXPR: expr.asm calls
	# into fp:: with a bare jsr.
	UDGEDIT:  load=ROM3HI, type=ro,  define=yes;
	HELP:     load=ROM3HI, type=ro;
	MEMCFG:   load=ROM3HI, type=ro;
	EXPR:     load=ROM3HI, type=ro,  define=yes;
	EXPR_BSS: load=RAM3, type=bss;
	FP:       load=ROM3HI, type=ro,  define=yes;
	FP_BSS:   load=RAM3, type=bss;

	#-----------------------------------------------------------------------
	# ROM4HI
	MACROCODE:  load=ROM4HI, type=ro,  define=yes;
	MACRO_VARS: load=RAM4, type=bss;
	MACROBSS:   load=RAM4, type=bss, define=yes;

	#-----------------------------------------------------------------------
	# ROM5HI
	LINKER:      load=ROM5HI, type=ro,  define=yes;
	LINKER_VARS: load=RAM5, type=bss, define=yes;
	LINKER_BSS:  load=RAM5, type=bss, define=yes;
	OBJCODE:     load=ROM5HI, type=ro,  define=yes;
	OBJVARS:     load=RAM5, type=bss, define=yes;
	OBJBSS:      load=RAM5, type=bss, define=yes;

	#-----------------------------------------------------------------------
	# ROM8HI
	COPYBUFF:      load=ROM8HI, type=ro,  define=yes;
	COPYBUFF_VARS: load=RAM8COPY, type=bss, define=yes;
	COPYBUFF_BSS:  load=RAM8COPY, type=bss, define=yes;

	#-----------------------------------------------------------------------
	# ROM11HI
	CONSOLE:      load=ROM11HI, type=ro;
	CONSOLE_BSS:  load=RAM0HI, type=bss;
	CONSOLE_VARS: load=RAM0HI, type=bss;

	#-----------------------------------------------------------------------
	# ROM6HI
	LABELS:     load=ROM6HI,   type=ro;
	LABEL_BSS:  load=RAM6,   type=bss;
	LABELNAMES: load=RAM7, type=bss;

	#-----------------------------------------------------------------------
	# ROM8HI
	CTX:     load=ROM8HI, type=ro;
	CTX_BSS: load=RAM8, type=bss;

	#-----------------------------------------------------------------------
	# BLOB storage (for some RODATA like error messages)
	ERRORS: load=ROM11HI, type=ro;

	#-----------------------------------------------------------------------
	# ROM8HI
	VSCREEN:     load=ROM3GFX, type=ro,  define=yes;
	VSCREEN_BSS: load=RAM3, type=bss, define=yes;

	#-----------------------------------------------------------------------
	# ROM3GFX
	SIM:             load=ROM9HI,         type=ro;

	#-----------------------------------------------------------------------
	# ROM3GFX
	FASTTEXT:        load=ROM3GFX,         type=ro, define=yes;
	VSYSRAM: load=RAM9, type=bss;
	FASTCOPY_BSS: load=RAM9, type=bss;
	FASTCOPY: load=ROM9HI, type=rw;
	FE3BOOT: load=ROM0HI, run=BOOTRAM, type=rw, define=yes;
	FE3CFG: load=ROM0HI, run=RAM123, type=rw, define=yes, align=2;
	FE3CONST: load=ROM1LO, type=ro;
	MAINBSS_NOINIT: load=MAINRAM, type=bss;
	FE3DIR: load=ROM0LO, type=rw;
	FE3DIR_BSS: load=DIRRAM, type=bss;
}
