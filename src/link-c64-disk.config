SYMBOLS {
  # the maximum size of a single line (also the size of the line buffer)
  __LINESIZE__:  type = export, value = 40;
}

# The C64 build keeps all code resident: the 64K address space is used for
# code (with the DEBUGGER segment and error strings under the KERNAL ROM at
# $e000 and BSS under the I/O space at $d000; Monster runs with $01=$34 so
# all RAM is visible).  Large data (source buffers, symbols, debug info,
# copy buffer, etc.) lives in the REU and is accessed via the reu:: transfer
# routines (see c64/ram.inc for the bank assignments).
#
# All areas up to $ff00 are emitted with fill so that monster-disk.prg is one
# contiguous image; it must be packed (exomizer) so that the loader can write
# the regions under the I/O space and KERNAL ROM.

MEMORY {
  # BASIC stub + one-time boot code.  LINEBUFF and SPARE overlay this region:
  # by the time they are written the boot code has finished with it.
  BOOT:
    start = $07ff
    size  = $0511
    fill  = yes;

  LINEBUFF:
    start = $0800
    size  = __LINESIZE__*3+1;

  SPARE:
    start = $0900
    size  = $0410;

  # main RAM: code and directly-accessed data
  RAM:
    start = $0d10
    size  = $cf00-$0d10
    fill  = yes;

  # relocated code that must survive while the user program is swapped in
  NMIHANDLER:
    start = $cf00
    size  = $60;

  TRAMPOLINE:
    start = $d000-$94
    size  = $17;

  # BSS under the I/O space; also emits the $cf00-$dfff span of the image
  # (as fill) to keep the file contiguous
  HIRAM:
    start = $cf00
    size  = $1100
    fill  = yes;

  # code and data under the KERNAL ROM.  Code here never runs while the
  # KERNAL is banked in: KERNAL calls go through the wrappers in low RAM
  # (c64/kernal.asm), which restore $01 = $34 before returning.
  HIRAM2:
    start = $e000
    size  = $1f00
    fill  = yes;

  # REU-resident (virtual) banks: these define address ranges only; the data
  # lives in the REU and is accessed via the reu:: routines
  LABELS_BANK:
    start = $000000
    size  = $ffff;

  LABELNAMES_BANK:
    start = $000000
    size  = $ffff;

  DEBUGINFO_BANK:
    start = $000000
    size  = $ffff;

  OBJ_BANK:
    start = $000000
    size  = $ffff;

  MACRO_BANK:
    start = $000000
    size  = $ffff;

  BUFF_BANK:
    start = $000000
    size  = $ffff;

  CTX_BANK:
    start = $000000
    size  = $ffff;

  # placeholder for the (unimplemented) SID player buffer
  SID_BANK:
    start = $001000
    size  = $1000;
}

SEGMENTS {
	# SETUP (BASIC stub + boot code)
	SETUP: load = BOOT, type = rw, define = yes;

	# DATA SEGMENTS
	DATA: load = RAM, run = RAM, type = rw, define = yes;

	# RODATA SEGMENTS
	RODATA: load = RAM, run = RAM, type = ro, define = yes;

	# CODE SEGMENTS
	IRQ:            load = RAM, run = RAM, type = ro, define = yes;
	DEBUGINFO_CODE: load = RAM, run = RAM, type = ro, define = yes;
	CODE:           load = RAM, run = RAM, type = ro, define = yes;
	GUICODE:        load = RAM, run = RAM, type = ro, define = yes;
	DBGUI:          load = RAM, run = RAM, type = ro, define = yes;
	ASMBANK:        load = RAM, run = RAM, type = ro, define = yes;
	EDITCODE:       load = RAM, run = RAM, type = ro, define = yes;
	COPYBUFF:       load = RAM, run = RAM, type = ro, define = yes;
	MACROCODE:      load = RAM, run = RAM, type = ro, define = yes;
	CONSOLE:        load = RAM, run = RAM, type = ro, define = yes;
	EXPR:           load = RAM, run = RAM, type = ro, define = yes;
	LABELS:         load = RAM, run = RAM, type = ro, define = yes;
	LINKER:         load = RAM, run = RAM, type = ro, define = yes;
	OBJCODE:        load = RAM, run = RAM, type = ro, define = yes;
	BANKCODE2:      load = RAM, run = RAM, type = ro, define = yes;
	CTX:            load = RAM, run = RAM, type = ro, define = yes;

	NMI_HANDLER:   load = RAM, run = NMIHANDLER, type = rw, define = yes;
	TRAMPOLINE:    load = RAM, run = TRAMPOLINE, type = rw, define = yes;

	# BSS SEGMENTS (main memory)
	LINEBUFF: load = LINEBUFF, type = bss;
	SPARE:    load = SPARE, type = bss;

	# BSS under the I/O space ($cf00-$cfff is left for the NMI handler and
	# trampoline)
	DEBUGINFO_VARS: load = HIRAM, type = bss, start = $d000;
	CONSOLE_BSS:    load = HIRAM, type = bss;
	CONSOLE_VARS:   load = HIRAM, type = bss;
	COPYBUFF_VARS:  load = HIRAM, type = bss, define = yes;
	MACRO_VARS:     load = HIRAM, type = bss;
	LINKER_VARS:    load = HIRAM, type = bss, define = yes;
	OBJVARS:        load = HIRAM, type = bss, define = yes;
	EXPR_BSS:       load = HIRAM, type = bss;
	BSS:            load = HIRAM, type = bss, define = yes;

	# linker section/segment tables. linker.asm accesses these with direct
	# addressing, so on the C64 they must be resident (not REU-backed).
	LINKER_BSS:     load = HIRAM, type = bss, define = yes;

	# code/data under the KERNAL ROM
	DEBUGGER: load = HIRAM2, type = rw, define = yes;
	ERRORS:   load = HIRAM2, type = ro;
	HELP:     load = HIRAM2, type = ro;

	SHAREBSS:   load = HIRAM2, type = bss;
	VSYSRAM:    load = HIRAM2, type = bss, define = yes;
	BSS_NOINIT: load = HIRAM2, type = bss, define = yes;

	# REU-resident data
	LABEL_BSS:    load = LABELS_BANK,     type = bss;
	LABELNAMES:   load = LABELNAMES_BANK, type = bss;

	DEBUGINFO:     load = DEBUGINFO_BANK, type = bss, define = yes;
	DEBUGINFO_BSS: load = DEBUGINFO_BANK, type = bss;

	# OBJBSS holds only the relocation-table buffer (accessed via the REU
	# LOADB_Y/STOREB_Y macros with reu::reuaddr+2 = FINAL_BANK_LINKER).
	OBJBSS:       load = OBJ_BANK,  type = bss, define = yes;
	COPYBUFF_BSS: load = BUFF_BANK, type = bss, define = yes;

	CTX_BSS:      load = CTX_BANK,   type = bss;
	MACROBSS:     load = MACRO_BANK, type = bss;

	SIDBUFF: load = SID_BANK, type = bss, define = yes;
}
