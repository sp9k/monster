SYMBOLS {
  # the rendered width of one screen line
  __LINESIZE__:  type = export, value = 40;
  # the maximum length of a logical (source) line; the line buffer holds this
  # many chars (must match config.inc)
  __MAX_LINE_LEN__:  type = export, value = 80;
}

# The C64 cartridge build targets a Magic Desk style cartridge (CRT type 19):
# 8 KiB banks mapped at $8000-$9fff, bank select via $de00 (bit 7 disables the
# cartridge).  Large data still lives in the REU exactly as in the disk build.
#
# Memory visibility contract (mirrors the vic20 UltiMem profiles):
#  - RAM below $8000 and $c000-$ceff are visible in every context; code and
#    data used by the banked subsystems must live there
#  - $0d10-$0fff holds source/SID state and the resident SID bank gate
#  - $1000-$1fff is the SID tune's private 4 KiB RAM window
#  - $a000-$bfff holds MAIN-context-only editor/GUI code (EDITMAIN/GUICODE);
#    it is shadowed by the BASIC ROM while a cart bank executes ($01=$37)
#  - the banked subsystems run in place at $8000-$9fff with $01=$37
#  - HIRAM ($d000, BSS only) and HIRAM2 ($e000) are MAIN-context-only
#
# File layout (= flash layout; each ROM area is a multiple of $2000):
#   bank 0     BOOTROM    cart header + boot/streaming code
#   banks 1-5  RESIMG     resident image, streamed to RAM at boot
#   bank 6     CONROM     monitor (CONSOLE)
#   bank 7     LNKROM     linker + object code
#   bank 8     LBLROM     labels
#   bank 9     DBGIROM    debug info
#   bank 10    MACROM     macros
#   bank 11    CTXROM     context + copy buffer
#   bank 12    DBGUIROM   memory/symbol viewers, watches, error log
#   bank 13    FILEDIRROM directory browser, iec, log
#   bank 14    ASMROM     assembler core
#   bank 15    VIEWROM    viewport and line formatting
#   bank 16    EXPRROM    expression evaluator
#   bank 17    SIDROM     SID loader/playback and image/linker helpers

MEMORY {
################################################################################
# ROM (flash image, in file order)
  BOOTROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 0;

  # resident image: linear flash addresses (bank 1 + (addr >> 13), offset
  # addr & $1fff); the boot code streams these segments to their run addresses
  RESIMG:
    start = $0000
    size  = $a000
    fill  = yes
    bank  = 1;

  CONROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 6;

  LNKROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 7;

  LBLROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 8;

  DBGIROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 9;

  MACROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 10;

  CTXROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 11;

  DBGUIROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 12;

  FILEDIRROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 13;

  ASMROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 14;

  VIEWROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 15;

  EXPRROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 16;

  SIDROM:
    start = $8000
    size  = $2000
    fill  = yes
    bank  = 17;

################################################################################
# RAM (run areas only; nothing is emitted for these)
  LINEBUFF:
    start = $0800
    # two line buffers (including terminators) + assembly buffer
    size  = 3*__MAX_LINE_LEN__+7;

  SPARE:
    start = $0900
    size  = $0410;

  # overlays SPARE: the boot loader runs here only until the editor starts
  BOOTLDR:
    start = $0900
    size  = $0410;

  AUXRAM:
    start = $0d10
    size  = $1000-$0d10;

  SIDRAM:
    start = $1000
    size  = $1000;

  # always-visible RAM: resident code and shared strings/data used by banked code
  LOWRAM:
    start = $2000
    size  = $8000-$2000;

  # MAIN-context-only RAM (BASIC ROM shadows reads at $01=$37)
  MIDRAM:
    start = $a000
    size  = $2000;

  # always-visible RAM for banked subsystem variables
  HIRAM3:
    start = $c000
    size  = $0f00;

  # relocated code that must survive while the user program is swapped in
  NMIHANDLER:
    start = $cf00
    size  = $a0;

  TRAMPOLINE:
    start = $cfa0
    size  = $40;

  # BSS under the I/O space (MAIN context only)
  HIRAM:
    start = $d000
    size  = $0800;

  CHIPRAM:
    start = $d800
    size  = $0800;

  # code and data under the KERNAL ROM (MAIN context only)
  HIRAM2:
    start = $e000
    size  = $1f00;

################################################################################
# REU-resident (virtual) banks: address ranges only; the data lives in the
# REU and is accessed via the reu:: routines
  # Contiguous REU symbol store: $1b0000-$20ffff. Metadata uses the
  # normal logical-bank accessors; the other pools use explicit page access.
  LABELS_BANK:
    start = $000000
    size  = $2000
    bank  = $1b;

  SYMBOL_RECORDS: start=$0000, size=$10000, bank=$1c;
  SYMBOL_NODES:   start=$0000, size=$10000, bank=$1d;
  SYMBOL_INDEXES: start=$0000, size=$10000, bank=$1e;
  SYMBOL_NAMES0:  start=$0000, size=$10000, bank=$1f;
  SYMBOL_NAMES1:  start=$0000, size=$10000, bank=$20;

  DEBUGINFO_BANK:
    start = $000000
    size  = $ffff;

  OBJ_BANK:
    start = $000000
    size  = $ffff;

  MACRO_BANK:
    start = $000000
    size  = $ffff;

  BUFF_BANK:
    start = $000000
    size  = $ffff;

  CTX_BANK:
    start = $000000
    size  = $ffff;

}

SEGMENTS {
	# cart header + boot code (runs in place from bank 0)
	SETUP: load = BOOTROM, type = ro, define = yes;

	# boot loader: copied to RAM by the boot code so it can stream the
	# resident image while switching ROM banks out from under itself
	BOOTLDR: load = BOOTROM, run = BOOTLDR, type = ro, define = yes;

	# resident image: streamed from flash to RAM by the boot code.
	# every segment here needs a reloc entry in c64/boot.asm.
	# NMI_HANDLER and TRAMPOLINE must stay first: cart_restore (c64/runtime.asm)
	# re-installs them from bank 1 and assumes they do not straddle a bank
	NMI_HANDLER: load = RESIMG, run = NMIHANDLER, type = rw, define = yes;
	TRAMPOLINE:  load = RESIMG, run = TRAMPOLINE, type = rw, define = yes;

	DATA:      load = RESIMG, run = LOWRAM, type = rw, define = yes;
	IRQ:       load = RESIMG, run = LOWRAM, type = ro, define = yes;
	BANKCODE2: load = RESIMG, run = LOWRAM, type = ro, define = yes;
	CODE:      load = RESIMG, run = LOWRAM, type = ro, define = yes;
	EDITCODE:  load = RESIMG, run = LOWRAM, type = ro, define = yes;

	RODATA:  load = RESIMG, run = LOWRAM, type = ro, define = yes;
	EDITMAIN: load = RESIMG, run = MIDRAM, type = ro, define = yes;
	GUICODE: load = RESIMG, run = MIDRAM, type = ro, define = yes;

	DEBUGGER: load = RESIMG, run = HIRAM2, type = rw, define = yes;
	CHIPCODE: load = RESIMG, run = CHIPRAM, type = rw, define = yes;
	ERRORS:   load = RESIMG, run = HIRAM2, type = ro, define = yes;
	HELP:     load = RESIMG, run = HIRAM2, type = ro, define = yes;
	SIDGATE:  load = RESIMG, run = AUXRAM, type = rw, define = yes;

	# banked subsystems (run in place at $8000-$9fff)
	CONSOLE:        load = CONROM,  type = ro, define = yes;
	LINKER:         load = LNKROM,  type = ro, define = yes;
	LINKER_AUX:     load = SIDROM,  type = ro, define = yes;
	OBJCODE:        load = LNKROM,  type = ro, define = yes;
	LABELS:         load = LBLROM,  type = ro, define = yes;
	DEBUGINFO_CODE: load = DBGIROM, type = ro, define = yes;
	MACROCODE:      load = MACROM,  type = ro, define = yes;
	CTX:            load = CTXROM,  type = ro, define = yes;
	COPYBUFF:       load = CTXROM,  type = ro, define = yes;
	DBGUI:          load = DBGUIROM, type = ro, define = yes;
	FILEDIR:        load = FILEDIRROM, type = ro, define = yes;
	ASMBANK:        load = ASMROM,  type = ro, define = yes;
	EXPR:           load = EXPRROM,  type = ro, define = yes;
	FP:             load = EXPRROM,  type = ro, define = yes;
	VSCREEN:        load = VIEWROM,  type = ro, define = yes;
	SIDCODE:        load = SIDROM,   type = ro, define = yes;

	# BSS in always-visible RAM (shared between contexts)
	LINEBUFF: load = LINEBUFF, type = bss;
	SPARE:    load = SPARE, type = bss;

	SHAREBSS:    load = LOWRAM, type = bss;
	BSS:         load = LOWRAM, type = bss, define = yes, align = $2;
	LINKER_VARS: load = LOWRAM, type = bss, define = yes;
	IMAGE_VARS:  load = LOWRAM, type = bss;
	LINKER_BSS:  load = LOWRAM, type = bss, define = yes;
	LINKER_RANGES: load = HIRAM3, type = bss;

	# banked subsystem variables (always-visible RAM)
	DEBUGINFO_VARS: load = HIRAM3, type = bss;
	CONSOLE_BSS:    load = HIRAM3, type = bss;
	CONSOLE_VARS:   load = HIRAM3, type = bss;
	COPYBUFF_VARS:  load = HIRAM3, type = bss, define = yes;
	MACRO_VARS:     load = HIRAM3, type = bss;
	OBJVARS:        load = LOWRAM, type = bss, define = yes;
	EXPR_BSS:       load = HIRAM3, type = bss;
	FP_BSS:         load = HIRAM3, type = bss;
	VSCREEN_BSS:    load = HIRAM3, type = bss;
	VIEW_SHARED:    load = HIRAM3, type = bss;

	# prog00/dbg00 (user zp/low-mem buffers). Must be OUTSIDE every range
	# swapped with the user image during GO ($0800-$ceff trampoline/NMI-stub
	# DMA, $e000-$fff7 load_delayed in run::go): the REU copy of those ranges
	# is stale for these buffers. HIRAM RAM is only accessible at $01=$34.
	VSYSRAM:    load = HIRAM, type = bss, define = yes;

	# uninitialized BSS. The banked assembler/source routines touch this
	# state while banked ($01=$37), so unlike the disk build it must live in
	# always-visible RAM rather than under the KERNAL ROM.
	BSS_NOINIT: load = LOWRAM, type = bss, define = yes;
	SRCVARS:    load = AUXRAM, type = bss, define = yes;
	SIDVARS:    load = AUXRAM, type = bss, define = yes;
	SIDBUFF:    load = SIDRAM, type = bss, define = yes;

	# REU-resident data
	LABEL_BSS:    load = LABELS_BANK,     type = bss;
	SYMBOL_RECORD_STORAGE: load=SYMBOL_RECORDS, type=bss;
	SYMBOL_NODE_STORAGE:   load=SYMBOL_NODES, type=bss;
	SYMBOL_INDEX_STORAGE:  load=SYMBOL_INDEXES, type=bss;
	SYMBOL_NAME_STORAGE0:  load=SYMBOL_NAMES0, type=bss;
	SYMBOL_NAME_STORAGE1:  load=SYMBOL_NAMES1, type=bss;

	DEBUGINFO:     load = DEBUGINFO_BANK, type = bss, define = yes;
	DEBUGINFO_BSS: load = DEBUGINFO_BANK, type = bss;

	# OBJBSS holds only the relocation-table buffer (accessed via the REU
	# LOADB_Y/STOREB_Y macros with reu::reuaddr+2 = FINAL_BANK_LINKER)
	OBJBSS:       load = OBJ_BANK,  type = bss, define = yes;
	COPYBUFF_BSS: load = BUFF_BANK, type = bss, define = yes;

	CTX_BSS:      load = CTX_BANK,   type = bss;
	MACROBSS:     load = MACRO_BANK, type = bss;

}
